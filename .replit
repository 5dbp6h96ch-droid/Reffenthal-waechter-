modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Reffenthal-Wächter"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NfB-Monitor"

[[workflows.workflow]]
name = "Reffenthal-Wächter"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd reffenthal-waechter && python watcher.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "NfB-Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/nfb-monitor && python app.py"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
